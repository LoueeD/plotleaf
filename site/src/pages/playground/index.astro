---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Playground · Plotleaf" workspace>
  <div slot="toolbar" class="workspace-tools"><label class="visually-hidden" for="example-select">Example</label><select id="example-select" aria-label="Example"></select><button class="secondary" id="reset-example" type="button">Reset example</button><label class="file-button">Open files<input class="visually-hidden" id="open-files" type="file" accept=".md,.json" multiple/></label><button id="download-report" type="button" disabled>Download HTML</button></div>
  <noscript><p class="play-help">The playground needs JavaScript. <a href="/examples/">Explore reports</a> or use the <a href="/docs/">CLI guide</a>.</p></noscript>
  <div id="playground" hidden>
    <div class="play-grid" id="play-grid"><section class="editor" aria-label="Source editor"><div class="file-tabs-bar"><div id="file-tabs" role="tablist" aria-label="Report files"></div><button id="add-file-tab" type="button" aria-label="Add JSON file" title="Add JSON file">+</button><button id="delete-file" type="button" aria-label="Remove selected JSON" title="Remove selected JSON" disabled>×</button></div><label class="visually-hidden" for="source-editor">File contents</label><textarea id="source-editor" role="tabpanel" spellcheck="false" autocapitalize="off" autocomplete="off"></textarea></section><div id="pane-resizer" role="separator" aria-label="Resize editor" aria-orientation="vertical" aria-valuemin="20" aria-valuemax="80" aria-valuenow="45" tabindex="0"></div><section class="preview-pane" aria-label="Rendered report"><div class="pane-heading"><h2>Preview</h2><span id="compile-status" role="status" aria-live="polite">Loading…</span></div><details id="compile-messages" hidden><summary id="diagnostic-summary">Validation messages</summary><ul id="diagnostics" aria-label="Validation messages"></ul></details><iframe id="report-preview" title="Report preview" sandbox="allow-scripts" hidden></iframe></section></div>
  </div>
  <p id="playground-error" role="alert"></p>
  <dialog id="add-file-dialog"><form id="add-file-form"><h2>Add JSON file</h2><label for="new-file">Filename</label><input id="new-file" placeholder="data.json" maxlength="120" required/><p id="new-file-error" role="alert"></p><div><button class="secondary" id="cancel-add-file" type="button">Cancel</button><button id="add-file" type="submit">Add file</button></div></form></dialog>
  <script>import '../../browser/playground';</script>
</Layout>
