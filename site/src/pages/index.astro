---
const fallbackPrompt = `Build a beautiful, interactive report with Plotleaf.
Here's what I want to explore: [Your brief and data]
Follow the guide from npx plotleaf guide and give me a preview and a standalone HTML report.`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Beautiful, interactive reports from Markdown and prepared data. Give your coding agent a brief. Get a report you can share." />
    <meta name="color-scheme" content="light dark" />
    <title>Plotleaf — Beautiful reports from Markdown</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="page">
      <header>
        <a class="wordmark" href="/" aria-label="Plotleaf home"><svg width="25" height="25" viewBox="0 0 28 28" aria-hidden="true"><path d="M4 24V9h4v15zm8 0V15h4v9zm8 0V3h4v21z" fill="currentColor" /></svg>plotleaf</a>
        <nav aria-label="Main navigation"><a href="/agent">Agent guide <span aria-hidden="true">↗</span></a><a href="https://github.com/LoueeD/plotleaf">GitHub <span aria-hidden="true">↗</span></a></nav>
      </header>
      <main>
        <section class="intro" aria-labelledby="headline">
          <p class="eyebrow">Built for coding agents.</p>
          <h1 id="headline">Beautiful reports.<br />One Markdown file.</h1>
          <p class="lede">Turn prepared data into an interactive report.<br class="desktop-break" /> Preview locally. Share one HTML file.</p>
        </section>
        <section class="start" aria-labelledby="start-title">
          <div class="prompt-heading"><h2 id="start-title">Start with your coding agent</h2><button id="copy-prompt" type="button" disabled>Copy prompt <span aria-hidden="true">↗</span></button></div>
          <pre id="agent-prompt" tabindex="0">{fallbackPrompt}</pre>
          <div class="prompt-footer"><span>Paste it into your agent. Add your brief and data.</span><span id="copy-status" role="status" aria-live="polite"></span></div>
        </section>
        <section class="terminal" aria-label="Start from your terminal"><p>Or open a report directly</p><code><span aria-hidden="true">$ </span>npx plotleaf report.md</code></section>
      </main>
      <footer><p>Open source. Local first. No account required.</p><div><a href="https://www.npmjs.com/package/plotleaf">npm</a><a href="https://github.com/LoueeD/plotleaf/blob/main/LICENSE">MIT license</a></div></footer>
    </div>
    <script is:inline type="module" src="/copy-prompt.js"></script>
  </body>
</html>
<style>
  :root { color-scheme: light dark; --page:#fff; --ink:#202123; --body:#55585d; --muted:#71757c; --rule:#e9eaec; --soft:#f5f6f7; --focus:#2787ce; --accent:#307eb7; }
  * { box-sizing:border-box; }
  body { margin:0; background:var(--page); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; -webkit-font-smoothing:antialiased; }
  a { color:inherit; text-decoration:none; }
  a:hover { text-decoration:underline; text-underline-offset:5px; }
  a:focus-visible,button:focus-visible,pre:focus-visible { outline:3px solid var(--focus); outline-offset:5px; }
  .page { max-width:1060px; margin:auto; padding:0 48px; }
  header { display:flex; justify-content:space-between; align-items:center; gap:24px; padding:36px 0; }
  .wordmark { display:inline-flex; align-items:center; gap:9px; font-size:26px; letter-spacing:-1px; font-weight:650; }
  .wordmark:hover { text-decoration:none; }
  nav { display:flex; gap:28px; font-size:14px; color:var(--body); }
  nav a { display:inline-flex; align-items:center; gap:5px; min-height:44px; }
  nav span { color:var(--muted); }
  .intro { padding:69px 0 43px; }
  .eyebrow { margin:0 0 20px; color:var(--accent); font-size:15px; font-weight:500; }
  h1 { font-size:clamp(42px,6.4vw,72px); line-height:1.08; letter-spacing:-.052em; font-weight:600; margin:0; }
  .lede { margin:25px 0 0; font-size:20px; line-height:1.65; color:var(--body); letter-spacing:-.015em; }
  .start { margin-top:9px; background:var(--soft); border:1px solid var(--rule); border-radius:12px; padding:25px 28px 22px; }
  .prompt-heading { display:flex; justify-content:space-between; align-items:center; gap:18px; }
  h2 { margin:0; font-size:15px; font-weight:600; }
  button { min-height:44px; border:0; border-radius:7px; padding:11px 16px; color:var(--page); background:var(--ink); font:inherit; font-size:13px; line-height:1.2; font-weight:500; cursor:pointer; white-space:nowrap; }
  button span { margin-left:10px; opacity:.65; }
  button:hover { opacity:.85; }
  button:disabled { opacity:.5; cursor:default; }
  pre { margin:26px 0 22px; white-space:pre-wrap; overflow-wrap:anywhere; font:13px/1.85 ui-monospace,SFMono-Regular,Consolas,monospace; color:var(--body); }
  .prompt-footer { display:flex; justify-content:space-between; gap:12px; align-items:baseline; font-size:12px; line-height:1.5; color:var(--muted); }
  #copy-status { color:var(--accent); flex-shrink:0; }
  .terminal { padding:29px 0 56px; display:flex; align-items:center; gap:22px; }
  .terminal p { margin:0; color:var(--muted); font-size:13px; }
  .terminal code { color:var(--body); font:13px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace; }
  .terminal code span { color:var(--muted); }
  footer { border-top:1px solid var(--rule); padding:24px 0 28px; display:flex; justify-content:space-between; align-items:center; gap:20px; color:var(--muted); font-size:12px; line-height:1.6; }
  footer p { margin:0; }
  footer div { display:flex; gap:22px; }
  @media(prefers-color-scheme:dark) { :root { --page:#18191b; --ink:#eceef0; --body:#b9bdc4; --muted:#a1a7b0; --rule:#30343a; --soft:#222529; --focus:#7dc9ff; --accent:#79bff0; } }
  @media(max-width:600px) { .page { padding:0 23px; } header { padding:22px 0; gap:16px; } .wordmark { font-size:23px; } nav { gap:16px; font-size:12px; } .intro { padding:48px 0 35px; } .eyebrow { margin-bottom:17px; font-size:14px; } h1 { font-size:44px; } .lede { font-size:17px; margin-top:21px; } .desktop-break { display:none; } .start { padding:20px; } .prompt-heading { gap:12px; } h2 { max-width:150px; font-size:14px; line-height:1.5; } button { padding:11px 12px; font-size:12px; } button span { display:none; } pre { margin-top:23px; font-size:12px; } .prompt-footer { display:block; font-size:11px; } #copy-status { display:block; min-height:17px; margin-top:5px; } .terminal { align-items:flex-start; flex-direction:column; gap:9px; padding:25px 0 38px; } footer { align-items:flex-start; flex-direction:column; gap:12px; } }
  @media(max-width:350px) { .page { padding:0 18px; } h1 { font-size:39px; } nav { gap:12px; } .start { padding:17px; } }
</style>
