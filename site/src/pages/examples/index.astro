---
import Layout from '../../layouts/Layout.astro';
import { readFile } from 'node:fs/promises';
const examples = JSON.parse(await readFile(new URL('../../../public/playground-projects.json',import.meta.url),'utf8'));
const cards=examples.filter((item:{slug:string})=>!['showcase','sparklines'].includes(item.slug));
---
<Layout title="Examples · Plotleaf">
  <div class="page-intro"><h1>See what one<br/>Markdown file can do.</h1><p>Real Plotleaf reports, rendered by the CLI from the bundled fictional datasets. Open a complete report, download its standalone HTML, or edit an example in your browser.</p></div>
  <section class="showcase" aria-labelledby="showcase-title"><p class="sample-kind">All components</p><h2 id="showcase-title">The complete showcase</h2><p>Metrics, interactive charts, funnel stages and rich tables together in one complete report. Open it as a full page, or download the same self-contained HTML.</p><div class="sample-links"><a href="/reports/showcase/" target="_blank" rel="noopener">Open the complete showcase ↗</a><a href="/reports/showcase/" download="plotleaf-showcase.html">Download HTML</a><a href="https://github.com/LoueeD/plotleaf/blob/main/examples/report.md">Markdown source ↗</a></div></section>
  <div class="examples-grid">{cards.map((item:{slug:string,name:string,kind:string,description:string,editable:boolean,file:string})=><article class="example-card"><p class="sample-kind">{item.kind}</p><h2>{item.name}</h2><p>{item.description}</p><div class="sample-links"><a href={`/reports/${item.slug}/`} target="_blank" rel="noopener">View report ↗</a>{item.editable && <a href={`/playground/?example=${item.slug}`}>Open in playground</a>}<a href={`/reports/${item.slug}/`} download={`plotleaf-${item.slug}.html`}>Download HTML</a><a href={`https://github.com/LoueeD/plotleaf/blob/main/${item.file}`}>Source ↗</a></div></article>)}</div>
</Layout>
