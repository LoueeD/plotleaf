{
  "version": 1,
  "syntax": "markdown-directives",
  "attributes": "Literal strings decoded according to each property schema. No JavaScript expressions.",
  "limits": {
    "markdownBytes": 1048576,
    "jsonBytes": 10485760,
    "totalBytes": 26214400,
    "datasets": 64,
    "rows": 100000,
    "chartRows": 10000,
    "donutSlices": 8,
    "funnelStages": 20,
    "tableRows": 1000,
    "tableColumns": 40,
    "sparklinePoints": 64,
    "imageFiles": 64,
    "imageBytes": 1048576,
    "imageDimension": 4096,
    "imagePixels": 4000000
  },
  "data": {
    "shape": "component datasets are arrays of flat JSON records; explicit table sparkline columns permit bounded numeric/null arrays only in their declared fields; explore bundles use their component-specific inputs/views schema",
    "resolution": "relative to the report directory; local .json files only",
    "percent": "ratios: 0.12 displays as 12%",
    "percentagePoints": "point values: 0.8 displays as 0.8 pt",
    "currency": "major units; omit .00 on whole amounts, preserve nonzero cents",
    "locale": "en-GB",
    "timeZone": "UTC"
  },
  "components": {
    "explore": {
      "description": "Scoped native controls select complete agent-prepared views. No analytics or report JavaScript.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "data",
          "title"
        ],
        "additionalProperties": false
      },
      "example": "::explore{data=\"./regional-views.json\" title=\"Regional performance\"}",
      "dataRules": {
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "inputs": {
              "minItems": 1,
              "maxItems": 6,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "select",
                          "segmented",
                          "text"
                        ]
                      },
                      "default": {
                        "type": "string",
                        "maxLength": 120
                      },
                      "options": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "string",
                              "maxLength": 120
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160
                            }
                          },
                          "required": [
                            "value",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "type",
                      "default",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "type": {
                        "type": "string",
                        "const": "number"
                      },
                      "default": {
                        "type": "number"
                      },
                      "options": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "number"
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160
                            }
                          },
                          "required": [
                            "value",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "type",
                      "default",
                      "options"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "type": {
                        "type": "string",
                        "const": "toggle"
                      },
                      "default": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "type",
                      "default"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "type": {
                        "type": "string",
                        "const": "date-range"
                      },
                      "default": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          },
                          "end": {
                            "type": "string",
                            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                          }
                        },
                        "required": [
                          "start",
                          "end"
                        ],
                        "additionalProperties": false
                      },
                      "options": {
                        "minItems": 1,
                        "maxItems": 20,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "value": {
                              "type": "object",
                              "properties": {
                                "start": {
                                  "type": "string",
                                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                },
                                "end": {
                                  "type": "string",
                                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                                }
                              },
                              "required": [
                                "start",
                                "end"
                              ],
                              "additionalProperties": false
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160
                            }
                          },
                          "required": [
                            "value",
                            "label"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "id",
                      "label",
                      "type",
                      "default",
                      "options"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "views": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "when": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 120
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "start": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            },
                            "end": {
                              "type": "string",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            }
                          },
                          "required": [
                            "start",
                            "end"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "markdown": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  },
                  "datasets": {
                    "default": {},
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
                    },
                    "additionalProperties": {
                      "maxItems": 10000,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    }
                  }
                },
                "required": [
                  "id",
                  "label",
                  "when",
                  "markdown",
                  "datasets"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "inputs",
            "views"
          ],
          "additionalProperties": false
        },
        "resolution": "Relative JSON bundle; inline view datasets override the same plain filename only within that view.",
        "limits": {
          "inputs": 6,
          "options": 20,
          "views": 32,
          "explorations": 4,
          "components": 512,
          "rows": 20000,
          "dataBytes": 8388608,
          "markdownBytes": 2097152,
          "jsonDepth": 32,
          "jsonContainers": 100000
        },
        "binding": "Every input affects exactly this exploration. Every view declares all input values. No matching combination hides the previous view."
      }
    },
    "grid": {
      "description": "A responsive row of one to four components.",
      "forms": [
        "container"
      ],
      "children": [
        "metric",
        "line",
        "area",
        "bar",
        "donut",
        "funnel",
        "table",
        "callout"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "columns": {
            "default": 2,
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "columns"
        ],
        "additionalProperties": false
      },
      "example": ":::grid{columns=\"4\"}\n::metric{label=\"Teams\" value=\"1492\"}\n:::"
    },
    "metric": {
      "description": "A prepared numeric value with optional comparison, direction and sentiment.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "value": {
            "type": "number"
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          },
          "comparison": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "direction": {
            "type": "string",
            "enum": [
              "up",
              "down",
              "flat"
            ]
          },
          "sentiment": {
            "default": "neutral",
            "type": "string",
            "enum": [
              "positive",
              "negative",
              "neutral"
            ]
          }
        },
        "required": [
          "label",
          "value",
          "format",
          "sentiment"
        ],
        "additionalProperties": false
      },
      "example": "::metric{label=\"Conversion\" value=\"0.103\" format=\"percent\"}"
    },
    "line": {
      "description": "An interactive single-series line chart from local JSON.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "x": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "y": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          },
          "xType": {
            "default": "category",
            "type": "string",
            "enum": [
              "category",
              "date",
              "number"
            ]
          },
          "target": {
            "type": "number"
          },
          "targetLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "data",
          "x",
          "y",
          "title",
          "format",
          "xType"
        ],
        "additionalProperties": false
      },
      "example": "::line{data=\"./usage.json\" x=\"date\" y=\"teams\" xType=\"date\" title=\"Active teams\"}"
    },
    "area": {
      "description": "A line chart with a restrained area fill.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "x": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "y": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          },
          "xType": {
            "default": "category",
            "type": "string",
            "enum": [
              "category",
              "date",
              "number"
            ]
          },
          "target": {
            "type": "number"
          },
          "targetLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "data",
          "x",
          "y",
          "title",
          "format",
          "xType"
        ],
        "additionalProperties": false
      },
      "example": "::area{data=\"./usage.json\" x=\"date\" y=\"teams\" xType=\"date\" title=\"Active teams\" target=\"1600\"}"
    },
    "bar": {
      "description": "An interactive category bar chart with a zero baseline.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "x": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "y": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          }
        },
        "required": [
          "data",
          "x",
          "y",
          "title",
          "format"
        ],
        "additionalProperties": false
      },
      "example": "::bar{data=\"./errors.json\" x=\"category\" y=\"count\" title=\"Errors by category\"}"
    },
    "donut": {
      "description": "A part-to-whole donut with a readable legend and native data table.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          }
        },
        "required": [
          "data",
          "category",
          "value",
          "title",
          "format"
        ],
        "additionalProperties": false
      },
      "example": "::donut{data=\"./plans.json\" category=\"plan\" value=\"teams\" title=\"Teams by plan\"}",
      "dataRules": {
        "category": "Unique nonblank strings of at most 1000 characters; source order is preserved.",
        "value": "Finite nonnegative numbers with a finite sum. Nulls and numeric strings are invalid. All-zero values show an empty state.",
        "maximumRows": 8
      }
    },
    "funnel": {
      "description": "Ordered stage/progress rows with prepared values, denominators, shares and optional explicit status. Works without JavaScript.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "stage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "total": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "share": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "default": "number",
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          }
        },
        "required": [
          "data",
          "stage",
          "value",
          "total",
          "share",
          "title",
          "format"
        ],
        "additionalProperties": false
      },
      "example": "::funnel{data=\"./funnel.json\" stage=\"stage\" value=\"teams\" total=\"baseline\" share=\"share\" status=\"status\" title=\"Funnel by stage\"}",
      "dataRules": {
        "stage": "Unique nonblank strings of at most 1000 characters; source order is preserved.",
        "value": "Finite nonnegative number no greater than its row's total.",
        "total": "Finite positive denominator supplied per row. No denominator is inferred from adjacent stages.",
        "share": "Prepared ratio from 0 to 1, matching value / total to within 0.0005 (rounding to 0.1 percentage point).",
        "status": [
          "on-target",
          "below-target",
          "at-risk",
          "neutral"
        ],
        "maximumRows": 20
      }
    },
    "table": {
      "description": "A semantic sortable table, with inferred or explicitly formatted columns.",
      "forms": [
        "leaf",
        "container"
      ],
      "children": [
        "column"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "data"
        ],
        "additionalProperties": false
      },
      "example": ":::table{data=\"./plans.json\" title=\"By plan\"}\n::column{field=\"plan\" label=\"Plan\"}\n::column{field=\"change\" label=\"Δ QoQ\" format=\"percent\" sign=\"always\"}\n:::"
    },
    "column": {
      "description": "A scalar, local image or bounded sparkline column. Omitted kind means scalar.",
      "forms": [
        "leaf"
      ],
      "children": [],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "kind": {
            "type": "string",
            "enum": [
              "scalar",
              "image",
              "sparkline"
            ]
          },
          "alt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sortBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "format": {
            "type": "string",
            "pattern": "^(number|percent|percentage-points|currency:[A-Z]{3})$"
          },
          "sign": {
            "default": "auto",
            "type": "string",
            "enum": [
              "auto",
              "always"
            ]
          },
          "semantics": {
            "default": "neutral",
            "type": "string",
            "enum": [
              "neutral",
              "higher-is-better",
              "lower-is-better"
            ]
          }
        },
        "required": [
          "field",
          "sign",
          "semantics"
        ],
        "additionalProperties": false
      },
      "example": "::column{field=\"change\" label=\"Δ QoQ\" format=\"percent\" sign=\"always\" semantics=\"higher-is-better\"}",
      "dataRules": {
        "image": "Local static PNG/JPEG path or null. alt names a nonblank string field for each image. Fixed 64 × 48 display box; deduplicated and embedded offline. Paths resolve from the report directory.",
        "sparkline": "Only explicitly declared sparkline fields may contain arrays: at most 64 finite numbers/nulls, in sample order. Nulls are gaps. Shared observed y scale per column; no aggregation or resampling.",
        "sortBy": "Optional scalar field for image/sparkline sorting. Without it a rich column has a plain header. Scalar columns sort their own raw values. Sort keys are readable in the export."
      }
    },
    "callout": {
      "description": "A contextual note or warning containing ordinary Markdown.",
      "forms": [
        "container"
      ],
      "children": [
        "markdown"
      ],
      "props": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tone": {
            "default": "note",
            "type": "string",
            "enum": [
              "note",
              "warning"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "tone"
        ],
        "additionalProperties": false
      },
      "example": ":::callout{title=\"Coverage\"}\nSeven complete days of prepared data.\n:::"
    }
  },
  "rules": [
    "Use explicit closing fences for containers.",
    "Components are standalone blocks, not inline/list/blockquote content.",
    "column is only allowed inside table; grids cannot nest.",
    "direction and explicitly supplied sentiment require metric comparison text.",
    "targetLabel requires target.",
    "Dataset fields are literal own-property keys, not expressions.",
    "Charts preserve source order; date/number x values must increase.",
    "Line/area null y values create gaps; bar null y values are invalid.",
    "Donut category/value fields must differ; category count is bounded, and all-zero values do not create equal slices.",
    "Funnel fields must differ; shares and denominators are supplied, validated and displayed per row, with no sorting or status inference.",
    "Only explicit image columns can load local static PNG/JPEG; every resource stays within the report root and shared byte limits.",
    "explore selects finite agent-prepared views using scoped native controls; nested explorations, arbitrary row queries, maps and executable components are not supported."
  ]
}
